+static inline uint32_t recomp_rdram_offset(gpr address) {
+    uint32_t a = (uint32_t)address;
+    return (a & 0x80000000u) ? a - 0x80000000u : RECOMP_KUSEG_WINDOW_BASE + (a & (RECOMP_KUSEG_WINDOW_SIZE - 1));
