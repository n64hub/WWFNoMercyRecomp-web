+void ultramodern::renderer::rdp_done() {
+    // The SP's message goes first, as on a console: the graphics thread sends it only once send_dl has read the task's
+    // inputs, which the renderer has by now.
+    sp_complete();
+    dp_complete();
+    rdp_done_sent = true;
+}
+
+bool ultramodern::renderer::take_rdp_done() {
+    const bool sent = rdp_done_sent;
+    rdp_done_sent = false;
+    return sent;
+}
