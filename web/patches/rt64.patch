 # includes to a depfile (DXC's -MF lists them without compiling), then compiles. Before, only the .hlsl was a
 # dependency, so a change to a shared struct (WcwRtParams) left the shaders that didn't change with the old layout.
 
+# The web's own DXC steps (WGSL, the prebuilt specialized shaders) in the same depfile form as the steps above.
+function(add_dxc_command OUTPUT FILENAME)
+    add_custom_command(OUTPUT ${OUTPUT}
+        COMMAND ${DXC} ${ARGN} ${FILENAME} /Fo ${OUTPUT} -MF ${OUTPUT}.d
+        COMMAND ${DXC} ${ARGN} ${FILENAME} /Fo ${OUTPUT}
+        DEPENDS ${FILENAME}
+        DEPFILE ${OUTPUT}.d)
+endfunction()
