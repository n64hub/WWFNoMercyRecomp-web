+            const Projection *curProj = workloadCamera(curIndex);
+            const Projection *prevProj = workloadCamera(prevIndex);
+            if ((curProj == nullptr) || (prevProj == nullptr)) {
+                return (curProj == prevProj) ? 0.0 : 1e12;
+            }
+            else if (curProj->type != prevProj->type) {
+                return 1e12;
+            }
