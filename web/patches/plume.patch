+
+    WebGPUBufferFormattedView::WebGPUBufferFormattedView(WebGPUBuffer *buffer, RenderFormat format) {
+        // WebGPU has no texel buffers. The view is kept so descriptor sets can bind the buffer as a storage buffer.
+        this->buffer = buffer;
